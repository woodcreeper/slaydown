# Generated by scripts/package-arch.sh from the same tested Linux release binary.
pkgname=slaydown-markdown
pkgver=@VERSION@
pkgrel=1
pkgdesc='A lightweight Markdown reader with beautiful typography'
arch=('x86_64')
url='https://github.com/woodcreeper/slaydown'
license=('MIT' 'GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'openssl' 'xdotool' 'librsvg' 'hicolor-icon-theme' 'desktop-file-utils')
optdepends=('sushi: Space-bar previews in Files (Nautilus)' 'gjs: Sushi preview renderer')
provides=('slaydown')
conflicts=('slaydown')
options=('!strip' '!debug')
source=('slaydown.deb' 'LICENSE')
sha256sums=('@DEB_SHA256@' '@LICENSE_SHA256@')

package() {
  local data_archive
  data_archive=$(find "$srcdir" -maxdepth 1 -name 'data.tar.*' -print -quit)
  test -n "$data_archive"
  bsdtar -xf "$data_archive" -C "$pkgdir"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
